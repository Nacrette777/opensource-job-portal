# GradBridge stack settings for deploy/gradbridge/compose.yml.
# Copy to a PRIVATE location (never commit the filled-in file) and pass it with
#   docker compose --env-file <path> -f deploy/gradbridge/compose.yml ...
# Values below are for the local production drill on *.localhost names.

COMPOSE_PROJECT_NAME=gradbridge-drill
IMAGE_TAG=local
# Path to the GradBridge Reactive Resume fork, relative to deploy/gradbridge/.
RR_SOURCE_DIR=../../../reactive-resume

# Public URLs (what browsers use). In Azure: the Container Apps' HTTPS FQDNs.
SITE_PUBLIC_URL=http://localhost:18173
RECRUITER_PUBLIC_URL=http://recruiter.gradbridge.localhost:18174
API_PUBLIC_URL=http://api.gradbridge.localhost:18000
RR_PUBLIC_URL=http://rr.gradbridge.localhost:18300
API_ALLOWED_HOSTS=api.gradbridge.localhost,localhost,127.0.0.1,api
# Plain-HTTP drill only; keep true (the default) behind HTTPS.
SECURE_COOKIES=false
# Stored times are naive local time in this zone (USE_TZ is off): set it before
# the first deployment and do not change it afterwards. Empty = Asia/Kolkata.
TIME_ZONE=Australia/Sydney

# Host ports for the drill (pick free ones).
API_HOST_PORT=18000
SITE_HOST_PORT=18173
RECRUITER_HOST_PORT=18174
RR_HOST_PORT=18300

# Secrets: generate fresh values per environment.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
PEELJOBS_DB_PASSWORD=
RR_DB_PASSWORD=
RR_AUTH_SECRET=

# Filled in after registering the OAuth client (see the deployment guide):
#   docker compose ... exec api python manage.py setup_rr_dev_integration \
#       --allow-production --client-name "GradBridge PeelJobs" --output /data/rr-oauth.json
RR_OAUTH_CLIENT_ID=
RR_OAUTH_CLIENT_SECRET=
RR_TOKEN_ENCRYPTION_KEY=
