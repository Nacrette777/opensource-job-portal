# Secrets for deploy/gradbridge/azure/deploy.ps1. Copy to a PRIVATE location, fill in fresh
# values, and never commit the filled-in file. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# RR_TOKEN_ENCRYPTION_KEY is a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep RR_TOKEN_ENCRYPTION_KEY with (but separate from) the backups: without it, every
# student must reconnect Reactive Resume after a restore.

DJANGO_SECRET_KEY=
PG_ADMIN_PASSWORD=
PEELJOBS_DB_PASSWORD=
RR_DB_PASSWORD=
RR_AUTH_SECRET=
RR_TOKEN_ENCRYPTION_KEY=
# Choose before the first data is written (USE_TZ is off); see section 2 of the guide.
TIME_ZONE=Australia/Sydney
